{
  "name": "fastify-log-filters",
  "version": "0.0.1",
  "description": "A Fastify plugin for conditional, filtered request/response logging: hide boring fast 2xxs, highlight slow and failed requests.",
  "keywords": [
    "fastify",
    "http",
    "logging",
    "nodejs",
    "plugin",
    "typescript"
  ],
  "homepage": "https://github.com/bhouston/fastify-smart-logging#readme",
  "bugs": {
    "url": "https://github.com/bhouston/fastify-smart-logging/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/fastify-smart-logging",
    "directory": "packages/fastify-log-filters"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit",
    "dev": "tsc -w --preserveWatchOutput --noEmitOnError",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "humanize-units": "^2.0.4"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
