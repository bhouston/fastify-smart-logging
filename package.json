{
  "name": "fastify-log-filters-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "start": "pnpm --filter basic-example start",
    "release": "semantic-release",
    "clean": "rimraf dist packages/**/dist demos/**/dist .nx node_modules packages/**/node_modules demos/**/node_modules",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc -b",
    "cloc": "npx cloc * --exclude-dir=node_modules,dist,.nx,.next,build"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.25",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "^7",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "zod": "^4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.27.0"
}
